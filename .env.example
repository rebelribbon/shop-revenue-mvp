# Variable names only. Values live in Vercel/Render environment settings (Section 23)
# or in an untracked .env.local for the local Supabase stack. Never commit values.

# Environment: local | test | preview | staging | production
APP_ENV=
APP_BASE_URL=
PUBLIC_SHORT_BASE_URL=

# Postgres connections, one per role (Section 9). Only migration_owner owns tables.
DATABASE_URL_MIGRATION=
DATABASE_URL_APP=
DATABASE_URL_WORKER=
DATABASE_URL_ADMIN=
# Worker LISTEN/NOTIFY needs a session connection (Supavisor session mode, port 5432);
# falls back to DATABASE_URL_WORKER when unset.
DATABASE_URL_WORKER_SESSION=
DATABASE_POOL_MAX=
# Privileged connection used only to create roles (local, CI, first-time hosted setup)
DATABASE_URL_BOOTSTRAP=
# Role passwords used by the bootstrap script
MIGRATION_OWNER_PASSWORD=
APP_USER_PASSWORD=
WORKER_USER_PASSWORD=
ADMIN_USER_PASSWORD=

# Supabase (Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_HOOK_SECRET=

# Internal admin (/admin): Google Workspace SSO restricted to our domain + allowlist
ADMIN_ALLOWED_EMAIL_DOMAIN=

# Secrets for signing device-trust cookies, invite tokens, view-as cookies
SESSION_SIGNING_SECRET=
# Envelope encryption key for EINs and Twilio subaccount tokens (pgcrypto)
DATA_ENCRYPTION_KEY=

# Providers. EMAIL_PROVIDER: smtp (local) | resend | postmark (legacy) | memory (tests);
# MESSAGING_PROVIDER: fake (local/preview) | twilio. Staging/production refuse anything else.
EMAIL_PROVIDER=
MESSAGING_PROVIDER=
PAYMENTS_BASE_URL=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SYSTEM_MESSAGING_SERVICE_SID=
# Resend: sending-only key scoped to the verified sending domain.
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
POSTMARK_WEBHOOK_USERNAME=
POSTMARK_WEBHOOK_PASSWORD=
EMAIL_FROM_ADDRESS=
# Local only: SMTP catcher (Mailpit)
SMTP_HOST=
SMTP_PORT=

# Worker
WORKER_CONCURRENCY=

# Observability
SERVICE_NAME=
GIT_SHA=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
LOG_LEVEL=
POSTHOG_API_KEY=

# Off-site backups (GitHub Actions "production" environment; separate AWS account)
BACKUP_DATABASE_URL=
BACKUP_S3_BUCKET=
BACKUP_AWS_REGION=
BACKUP_AWS_ROLE_ARN=
BACKUP_AGE_RECIPIENT=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# Developer tooling for hosted projects (scripts/dev/hosted-env.ts)
SUPABASE_DEV_PROJECT_REF=
SUPABASE_DEV_DB_PASSWORD=
SUPABASE_POOLER_HOST=

